# AWS Configuration
REACT_APP_AWS_REGION=us-east-1

# DynamoDB Table Names
REACT_APP_DYNAMODB_TABLE_EVENTS=streamforge-dev-processed-data
REACT_APP_DYNAMODB_TABLE_METRICS=streamforge-dev-aggregated-metrics
REACT_APP_DYNAMODB_TABLE_DLQ=streamforge-dev-dead-letter-queue

# API Endpoint (optional - for API Gateway)
REACT_APP_API_ENDPOINT=

# Cognito Configuration (optional - for authentication)
REACT_APP_IDENTITY_POOL_ID=
REACT_APP_USER_POOL_ID=
REACT_APP_USER_POOL_CLIENT_ID=

# S3/CloudFront (optional - for hosting)
REACT_APP_S3_BUCKET=
REACT_APP_CLOUDFRONT_URL=

# Development Mode
# Set to 'true' to use mock data when AWS credentials are not available
REACT_APP_USE_MOCK_DATA=false
